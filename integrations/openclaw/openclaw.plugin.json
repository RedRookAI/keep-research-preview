{
  "id": "keep",
  "name": "Keep",
  "description": "Restricted Keep repository submission and status.",
  "version": "0.0.19-preview.1",
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "endpoint",
      "clientId",
      "grantId",
      "commandBinding",
      "openclawAgentId",
      "tokenFile",
      "stateDirectory",
      "requestTimeoutMs"
    ],
    "properties": {
      "endpoint": {
        "type": "string"
      },
      "clientId": {
        "type": "string",
        "maxLength": 128
      },
      "grantId": {
        "type": "string",
        "maxLength": 128
      },
      "commandBinding": {
        "type": "string",
        "pattern": "^[a-f0-9]{64}$"
      },
      "openclawAgentId": {
        "type": "string",
        "maxLength": 128
      },
      "tokenFile": {
        "type": "string"
      },
      "stateDirectory": {
        "type": "string"
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 2147483647
      }
    }
  },
  "activation": {
    "onStartup": true
  },
  "contracts": {
    "tools": [
      "keep_submit",
      "keep_status"
    ]
  },
  "toolMetadata": {
    "keep_submit": {
      "optional": true
    },
    "keep_status": {
      "optional": true
    }
  }
}
