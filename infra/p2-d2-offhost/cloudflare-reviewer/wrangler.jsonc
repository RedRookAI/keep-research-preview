{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "keep-p2-d2-reviewer-anthropic",
  "main": "src/index.js",
  "compatibility_date": "2026-08-27",
  "durable_objects": {
    "bindings": [{ "name": "REVIEWER_KEY", "class_name": "ReviewerKey" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ReviewerKey"] }]
}
