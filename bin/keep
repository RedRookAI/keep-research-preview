#!/bin/sh
# Run the self-contained archive with the owner's selected Node 22 runtime.
set -eu
keep_node=${KEEP_NODE_EXECUTABLE:-node}
"$keep_node" -e 'const [major, minor, patch] = process.versions.node.split(".").map(Number); if (major !== 22 || minor < 23 || (minor === 23 && patch < 3)) { console.error("Keep requires Node 22.23.3 or later on the Node 22 line. Set KEEP_NODE_EXECUTABLE to the selected runtime."); process.exit(1); }'
keep_package=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
exec "$keep_node" "$keep_package/dist/src/main.js" "$@"
